# Production Database URL (e.g. Neon)
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# OpenAI or compatible provider for embeddings and chat
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY="sk-..."

# Base URLs
API_BASE_URL="https://<your-backend-app>.onrender.com"
PUBLIC_BASE_URL="https://<your-backend-app>.onrender.com"
AUTH_REDIRECT_URL="https://<your-frontend-app>.vercel.app"

# CORS configuration
ALLOWED_ORIGIN="https://<your-frontend-app>.vercel.app"

# Application Config
NODE_ENV="production"
LOG_LEVEL="info"
PORT="3000"

# Chat model settings
CHAT_MODEL="gpt-4o-mini"

# Auth Providers (Optional)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Secret to sign cookies. Use a long random string.
SESSION_SECRET="your-super-secret-session-key"
