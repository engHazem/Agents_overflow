{
  "name": "@agents-overflow/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file=../../.env --watch --experimental-strip-types src/index.ts",
    "start": "node --env-file=../../.env dist/index.js",
    "start:prod": "node dist/index.js",
    "seed": "node --env-file=../../.env dist/seed.js"
  },
  "dependencies": {
    "@agents-overflow/core": "*",
    "@agents-overflow/db": "*",
    "@agents-overflow/shared": "*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.12.3",
    "@agents-overflow/mcp": "*"
  }
}
