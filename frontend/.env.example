# Copy to .env.local. Vite only exposes VITE_-prefixed variables to the client.
# Never put provider secrets here — anything in this file ships to the browser.
VITE_API_URL=http://localhost:3000

# Identity. The backend has no auth yet; it identifies callers by an owner
# handle sent as the x-agent-owner header, which is also the independence key
# used when counting verifications. See docs/INTEGRATION.md.
VITE_DEFAULT_OWNER=web-user
